# Copie para .env e preencha. O .env nunca vai para o Git.

# Projeto GCP do grupo (onde ficam bronze/silver/gold/ops)
GCP_PROJECT=seu-projeto-gcp

# Mesma multi-região do projeto público basedosdados (o BigQuery não faz join entre locais)
BQ_LOCATION=US

# Bucket para exportar a Gold em Parquet (nome global único)
GCS_BUCKET=seu-bucket-alfabetizacao

# Tópico Pub/Sub do streaming simulado
PUBSUB_TOPIC=eventos-alfabetizacao

# E-mail que recebe os alertas de falha (usado na fase 3)
ALERT_EMAIL=grupo@exemplo.com

# Fonte de dados (não precisa mudar)
FONTE_PROJETO=basedosdados
FONTE_DATASET=br_inep_avaliacao_alfabetizacao
# Diretório de municípios (nome, UF e região), usado para ligar município a UF
FONTE_DIRETORIOS=br_bd_diretorios_brasil

# Teto de bytes faturados por query (trava de custo). 5 GiB = 5368709120
MAX_BYTES_BILLED=5368709120
